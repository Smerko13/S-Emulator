<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="headerComponent" styleClass="root" alignment="CENTER" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.header.HeaderController">
    <padding>
        <Insets bottom="5.0" top="5.0" />
    </padding>
    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <opaqueInsets>
            <Insets />
        </opaqueInsets>
        <padding>
            <Insets bottom="5.0" top="5.0" />
        </padding>
        <Button fx:id="loadFileButton" mnemonicParsing="false" onAction="#loadFileButtonPressed" text="Load File" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </Button>
        <TextField fx:id="filePathTextBox" editable="false" promptText="Path to current program" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </TextField>
    </HBox>
    <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
        <children>
          <ComboBox fx:id="FunctionAndProgramSelector" promptText="Program/Function Selector">
              <opaqueInsets>
                  <Insets left="5.0" right="5.0" />
              </opaqueInsets>
              <HBox.margin>
                  <Insets left="5.0" right="5.0" />
              </HBox.margin>
          </ComboBox>
          <Button fx:id="CollapseButton" mnemonicParsing="false" onAction="#CollapseProgram" text="Collapse">
              <opaqueInsets>
                  <Insets left="5.0" right="5.0" />
              </opaqueInsets>
              <HBox.margin>
                  <Insets left="5.0" right="5.0" />
              </HBox.margin>
          </Button>
         <Label text="Degree:">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Label>
         <TextField fx:id="currentDegreeTextField" onAction="#degreeInserted" prefHeight="25.0" prefWidth="53.0" promptText="Current" />
          <Label fx:id="DegreeLabel" text="/Maximum Degree">
              <HBox.margin>
                  <Insets left="5.0" right="5.0" />
              </HBox.margin>
          </Label>
          <Button fx:id="ExpandButton" mnemonicParsing="false" onAction="#ExpandProgram" text="Expand">
              <HBox.margin>
                  <Insets left="5.0" right="5.0" />
              </HBox.margin>
          </Button>
          <ComboBox fx:id="highLightSelector" promptText="Highlight Selection ">
              <HBox.margin>
                  <Insets left="5.0" right="5.0" />
              </HBox.margin>
          </ComboBox>
            <ComboBox fx:id="themeSelector" promptText="Theme" />
        </children>
        <padding>
          <Insets bottom="5.0" top="5.0" />
        </padding>
    </HBox>
</VBox>
