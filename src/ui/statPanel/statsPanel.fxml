<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<VBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.statPanel.StatPanelController">
    <HBox alignment="CENTER">
        <ComboBox fx:id="runNumbersBox" promptText="Execution Number">
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </ComboBox>
        <Button fx:id="showHistoryButton" mnemonicParsing="false" onAction="#showSelectedHistory" text="Show Stats">
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </Button>
        <Button fx:id="reRunButton" mnemonicParsing="false" onAction="#reRunProgram" text="Re-Run">
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </Button>
    </HBox>
    <TextFlow fx:id="historyDetailsBox" />
</VBox>
