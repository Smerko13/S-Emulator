<?xml version="1.0" encoding="UTF-8"?>
<web-app
        xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
        version="6.0">

    <display-name>S-Emulator-Server</display-name>

    <!-- Login servlet mapping -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlets.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Users List servlet mapping -->
    <servlet>
        <servlet-name>UsersListServlet</servlet-name>
        <servlet-class>servlets.UsersListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UsersListServlet</servlet-name>
        <url-pattern>/userslist</url-pattern>
    </servlet-mapping>

    <!-- Execution History servlet mapping -->
    <servlet>
        <servlet-name>ExecutionHistoryServlet</servlet-name>
        <servlet-class>servlets.ExecutionHistoryServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ExecutionHistoryServlet</servlet-name>
        <url-pattern>/executionHistory</url-pattern>
    </servlet-mapping>

    <!-- Programs servlet mapping -->
    <servlet>
        <servlet-name>ProgramsServlet</servlet-name>
        <servlet-class>servlets.ProgramsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProgramsServlet</servlet-name>
        <url-pattern>/programs</url-pattern>
    </servlet-mapping>

    <!-- Optional: default welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
