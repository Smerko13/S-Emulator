<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.mainDashboard.header.HeaderController" maxWidth="1.7976931348623157E308" spacing="3.0">
   <children>
      <HBox alignment="CENTER" fillHeight="false" maxWidth="1.7976931348623157E308" VBox.vgrow="NEVER">
         <children>
            <Label fx:id="userNameLabel" text="User Name:" HBox.hgrow="NEVER">
               <opaqueInsets>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </opaqueInsets>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" text="S-Emulator - Dashboard" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
            <Region disable="true" HBox.hgrow="ALWAYS" />
            <Label fx:id="creditsLabel" id="Avaliable Credits: 0" alignment="CENTER_RIGHT" contentDisplay="RIGHT" text="Avaliable Credits: 0" HBox.hgrow="NEVER">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER" fillHeight="false" maxWidth="1.7976931348623157E308" VBox.vgrow="NEVER">
         <children>
            <Button fx:id="loadFileButton" mnemonicParsing="false" text="Load File" onAction="#loadFileButtonPressed">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <TextField fx:id="filePathTextField" prefWidth="540.0" promptText="Currently Loaded File Path">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </TextField>
            <Region disable="true" HBox.hgrow="ALWAYS" />
            <Button fx:id="chargeCreditsButton" mnemonicParsing="false" text="Charge Credits" onAction="#chargeCreditsButtonPressed">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <TextField fx:id="creditInputTextField" promptText="Credits">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
   </children>
</VBox>
