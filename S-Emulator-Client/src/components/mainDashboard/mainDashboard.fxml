<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
          xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="components.mainDashboard.clientMainController">

    <!-- 2 columns: 40% users panel / 60% programs panel -->
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" percentWidth="40.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="400.0" percentWidth="60.0" />
    </columnConstraints>

    <!-- row 0 = header (fixed height), row 1 = main content (grows) -->
    <rowConstraints>
        <RowConstraints minHeight="40.0" prefHeight="60.0" vgrow="NEVER" />   <!-- header -->
        <RowConstraints minHeight="400.0" vgrow="ALWAYS" />                   <!-- users and programs -->
    </rowConstraints>

    <children>
        <fx:include fx:id="headerPanel" source="header/header.fxml"
                    GridPane.columnIndex="0" GridPane.columnSpan="2"
                    GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="NEVER" />
        <fx:include fx:id="usersPanel" source="users/users.fxml"
                    GridPane.columnIndex="0" GridPane.hgrow="ALWAYS"
                    GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
        <fx:include fx:id="programsAndFunctionsPanel" source="ProgramsAndFunctions/ProgramsAndFunctions.fxml"
                    GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"
                    GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</GridPane>
