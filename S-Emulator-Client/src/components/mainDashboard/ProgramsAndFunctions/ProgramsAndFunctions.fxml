<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" spacing="3.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.mainDashboard.ProgramsAndFunctions.ProgramsAndFunctionsController">
   <children>
      <Label fx:id="chatUsersLabel" text="Available Programs:">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
         <VBox.margin>
            <Insets bottom="8.0" top="8.0" />
         </VBox.margin>
      </Label>
      <TableView fx:id="programsTable">
         <columns>
            <TableColumn fx:id="programNameColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Program&#10;Name" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="uploaderNameColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Uploader&#10;Name" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="numOfInstructionsColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Number Of&#10;Instructions" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="maxDegreeColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Max&#10;Degree" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="numOfExecutionsColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Number Of&#10;Executions" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="avgCreditCostColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0">
                <graphic>
                    <Label text="Avg Credit&#10;Cost" />
                </graphic>
            </TableColumn>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="executeProgramButton" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#executeProgramButtonPressed" text="Execute Program" />
       <AnchorPane fx:id="statsComponent" styleClass="root">
           <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <Label alignment="CENTER" contentDisplay="CENTER" text="Available Functions:" textAlignment="CENTER">
                   <VBox.margin>
                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                   </VBox.margin>
                   <font>
                       <Font name="System Bold" size="16.0" />
                   </font>
               </Label>
               <TableView fx:id="functionsTable" prefHeight="410.0" prefWidth="512.6666666666667">
                   <columns>
                       <TableColumn fx:id="functionNameColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="-1.0" sortable="false">
                            <graphic>
                                 <Label text="Function&#10;Name" />
                            </graphic>
                          </TableColumn>
                       <TableColumn fx:id="associatedProgramColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0" sortable="false">
                            <graphic>
                                 <Label text="Associated&#10;Program" />
                            </graphic>
                          </TableColumn>
                       <TableColumn fx:id="associatedUserColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0" sortable="false">
                            <graphic>
                                 <Label text="Associated&#10;User" />
                            </graphic>
                          </TableColumn>
                       <TableColumn fx:id="numOfInstructionsInFunctionColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="75.0" prefWidth="-1.0" sortable="false">
                            <graphic>
                                 <Label text="Num Of&#10;Instructions" />
                            </graphic>
                          </TableColumn>
                       <TableColumn fx:id="maxDegreeForFunctionColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="50.0" prefWidth="-1.0" sortable="false">
                            <graphic>
                                 <Label text="Max&#10;Degree" />
                            </graphic>
                          </TableColumn>
                   </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               </TableView>
               <HBox />
           </VBox>
       </AnchorPane>
      <Button fx:id="executeFunctionButton" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#executeFunctionButtonPressed" text="Execute Function" />
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
