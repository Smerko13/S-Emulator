<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      spacing="3.0" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="components.mainDashboard.ProgramsAndFunctions.ProgramsAndFunctionsController">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>

    <children>
        <!-- Programs Section -->
        <Label text="Main Programs:">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <VBox.margin>
                <Insets bottom="8.0" top="8.0" />
            </VBox.margin>
        </Label>

        <TableView fx:id="programsTable" VBox.vgrow="ALWAYS" minHeight="150.0">
            <columns>
                <TableColumn fx:id="programNameColumn" maxWidth="1.7976931348623157E308" minWidth="80.0" prefWidth="120.0">
                    <graphic><Label text="Program&#10;Name" /></graphic>
                </TableColumn>
                <TableColumn fx:id="programUploaderColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Uploader&#10;Name" /></graphic>
                </TableColumn>
                <TableColumn fx:id="programInstructionsColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Instruction&#10;Count (L0)" /></graphic>
                </TableColumn>
                <TableColumn fx:id="programMaxLevelColumn" maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="80.0">
                    <graphic><Label text="Maximum&#10;Level" /></graphic>
                </TableColumn>
                <TableColumn fx:id="programExecutionsColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Executions&#10;Count" /></graphic>
                </TableColumn>
                <TableColumn fx:id="programAvgCostColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Average&#10;Credit Cost" /></graphic>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>

        <Button fx:id="executeProgramButton" text="Execute Selected Program"
                onAction="#executeProgramButtonPressed" maxWidth="1.7976931348623157E308">
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </Button>

        <!-- Functions Section -->
        <Label text="Helper Functions:">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <VBox.margin>
                <Insets bottom="8.0" top="20.0" />
            </VBox.margin>
        </Label>

        <TableView fx:id="functionsTable" VBox.vgrow="ALWAYS" minHeight="150.0">
            <columns>
                <TableColumn fx:id="functionNameColumn" maxWidth="1.7976931348623157E308" minWidth="80.0" prefWidth="120.0">
                    <graphic><Label text="Function&#10;Name" /></graphic>
                </TableColumn>
                <TableColumn fx:id="parentProgramColumn" maxWidth="1.7976931348623157E308" minWidth="80.0" prefWidth="120.0">
                    <graphic><Label text="Parent&#10;Program" /></graphic>
                </TableColumn>
                <TableColumn fx:id="functionUploaderColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Uploader&#10;Name" /></graphic>
                </TableColumn>
                <TableColumn fx:id="functionInstructionsColumn" maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="90.0">
                    <graphic><Label text="Instruction&#10;Count (L0)" /></graphic>
                </TableColumn>
                <TableColumn fx:id="functionMaxLevelColumn" maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="80.0">
                    <graphic><Label text="Maximum&#10;Level" /></graphic>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>

        <Button fx:id="executeFunctionButton" text="Execute Selected Function"
                onAction="#executeFunctionButtonPressed" maxWidth="1.7976931348623157E308">
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
