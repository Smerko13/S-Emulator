<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" spacing="3.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.mainDashboard.users.UsersController">
   <children>
      <Label fx:id="chatUsersLabel" text="S-Emulator Users:">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
         <VBox.margin>
            <Insets bottom="8.0" top="8.0" />
         </VBox.margin>
      </Label>
      <TableView>
        <columns>
          <TableColumn maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0" text="User Name" />
          <TableColumn maxWidth="1.7976931348623157E308" minWidth="120.0" prefWidth="-1.0" text="Programs Uploaded" />
            <TableColumn maxWidth="1.7976931348623157E308" minWidth="120.0" prefWidth="-1.0" text="Functions Uploaded" />
            <TableColumn maxWidth="1.7976931348623157E308" minWidth="90.0" prefWidth="-1.0" text="Current Credits" />
            <TableColumn maxWidth="1.7976931348623157E308" minWidth="80.0" prefWidth="-1.0" text="Credits Used" />
            <TableColumn maxWidth="1.7976931348623157E308" minWidth="70.0" prefWidth="-1.0" text="Executions" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" text="Unselect User" />
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
