<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      styleClass="root" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="components.executionDashboard.instructionPanel.InstructionTableController">
    <children>
        <TableView fx:id="instructionTableView" editable="true" VBox.vgrow="ALWAYS" minHeight="200.0">
            <columns>
                <TableColumn fx:id="idColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="40.0" prefWidth="50.0" sortable="false" text="#" />
                <TableColumn fx:id="typeColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="40.0" prefWidth="50.0" sortable="false" text="B\S" />
                <TableColumn fx:id="cyclesColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="50.0" prefWidth="60.0" sortable="false" text="Cycles" />
                <TableColumn fx:id="labelColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="80.0" sortable="false" text="Label" />
                <TableColumn fx:id="instructionColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="150.0" prefWidth="300.0" sortable="false" text="Instruction" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" minHeight="40.0">
            <children>
                <TextFlow fx:id="SummaryLineTextBox" />
                <Region HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Region>
                <Button fx:id="SummaryButton" maxHeight="1.7976931348623157E308" minHeight="-Infinity"
                        mnemonicParsing="false" onAction="#ShowProgramSummary" text="Show Program Summary">
                    <HBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </HBox.margin>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
