<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" styleClass="root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.executionDashboard.executionPanel.ExecutionPanelController">
    <VBox>
        <HBox alignment="CENTER">
            <Button fx:id="programExecuteButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false"
                    onAction="#executeButtonPressed" text="Execute Program" textAlignment="CENTER">
                <opaqueInsets>
                    <Insets/>
                </opaqueInsets>
                <HBox.margin>
                    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
                </HBox.margin>
            </Button>
            <Button fx:id="startDebugButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false"
                    onAction="#debugButtonPressed" text="Debug Program" textAlignment="CENTER">
                <opaqueInsets>
                    <Insets/>
                </opaqueInsets>
                <HBox.margin>
                    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
                </HBox.margin>
            </Button>
            <Button fx:id="newRunButton" mnemonicParsing="false" onAction="#newRunButtonPressed" text="New Run">
                <HBox.margin>
                    <Insets left="5.0" right="5.0"/>
                </HBox.margin>
            </Button>
        </HBox>
        <HBox alignment="CENTER" fillHeight="false">
          <Button fx:id="stepOverButton" mnemonicParsing="false" onAction="#stepOverPressed" text="Step Over">
              <HBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
              </HBox.margin>
          </Button>
            <Button fx:id="stopDebugButton" alignment="CENTER" contentDisplay="CENTER" layoutX="310.0" layoutY="10.0"
                    mnemonicParsing="false" onAction="#stopDebugPressed" text="Stop Debug" textAlignment="CENTER">
                <opaqueInsets>
                    <Insets/>
                </opaqueInsets>
                <HBox.margin>
                    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
                </HBox.margin>
            </Button>
            <Button fx:id="continueButton" alignment="CENTER" contentDisplay="CENTER" layoutX="363.0" layoutY="10.0"
                    mnemonicParsing="false" onAction="#continueButtonPressed" text="Continue" textAlignment="CENTER">
                <opaqueInsets>
                    <Insets/>
                </opaqueInsets>
                <HBox.margin>
                    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
                </HBox.margin>
            </Button>
        </HBox>
    </VBox>
    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="10.0" top="10.0" />
        </padding>
        <VBox>
            <HBox.margin>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </HBox.margin>
            <TableView fx:id="allVarsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="90.0" text="Variable" />
                    <TableColumn maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="90.0" text="Value" />
                </columns>
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0" />
                </VBox.margin>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Label fx:id="cyclesLabel" alignment="CENTER" contentDisplay="CENTER" text="Cycles:" textAlignment="CENTER">
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0" />
                </VBox.margin>
            </Label>
        </VBox>
        <VBox>
            <HBox.margin>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
            </HBox.margin>
            <ComboBox fx:id="architectureComboBox" prefWidth="150.0" promptText="Architecture">
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0"/>
                </VBox.margin>
            </ComboBox>
            <TableView fx:id="inputVarsTable" editable="true">
                <columns>
                    <TableColumn maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="122.0"
                                 text="Input Variable"/>
                    <TableColumn maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="122.0" text="Value"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0"/>
                </VBox.margin>
            </TableView>
            <Button fx:id="backToMainDashBoardButton" mnemonicParsing="false" onAction="#backToMainDashBoard"
                    text="Back To Main Dashboard">
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0"/>
                </VBox.margin>
            </Button>
        </VBox>
    </HBox>
</VBox>
