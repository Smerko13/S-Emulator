<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      spacing="5.0" styleClass="root" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="components.executionDashboard.executionPanel.ExecutionPanelController">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>

    <children>
        <!-- Control Buttons Section -->
        <VBox spacing="5.0">
            <HBox alignment="CENTER" spacing="5.0">
                <Button fx:id="programExecuteButton" alignment="CENTER" mnemonicParsing="false"
                        onAction="#executeButtonPressed" text="Execute Program" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button fx:id="startDebugButton" alignment="CENTER" mnemonicParsing="false"
                        onAction="#debugButtonPressed" text="Debug Program" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox alignment="CENTER" spacing="5.0">
                <Button fx:id="stepOverButton" mnemonicParsing="false" onAction="#stepOverPressed"
                        text="Step Over" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button fx:id="continueButton" alignment="CENTER" mnemonicParsing="false"
                        onAction="#continueButtonPressed" text="Continue" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox alignment="CENTER" spacing="5.0">
                <Button fx:id="stopDebugButton" alignment="CENTER" mnemonicParsing="false"
                        onAction="#stopDebugPressed" text="Stop Debug" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button fx:id="newRunButton" mnemonicParsing="false" onAction="#newRunButtonPressed"
                        text="New Run" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <!-- Architecture Selector -->
        <ComboBox fx:id="architectureComboBox" maxWidth="1.7976931348623157E308" promptText="Architecture">
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </ComboBox>

        <!-- Input Variables Table -->
        <Label text="Input Variables:" />
        <TableView fx:id="inputVarsTable" editable="true" VBox.vgrow="ALWAYS" minHeight="100.0">
            <columns>
                <TableColumn maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="100.0" text="Input Variable" />
                <TableColumn maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="100.0" text="Value" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Spacer -->
        <Region VBox.vgrow="SOMETIMES" minHeight="10.0" />

        <!-- All Variables Table -->
        <Label text="All Variables:" />
        <TableView fx:id="allVarsTable" VBox.vgrow="ALWAYS" minHeight="100.0">
            <columns>
                <TableColumn maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="100.0" text="Variable" />
                <TableColumn maxWidth="1.7976931348623157E308" minWidth="60.0" prefWidth="100.0" text="Value" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Cycles Label -->
        <Label fx:id="cyclesLabel" alignment="CENTER" text="Cycles: 0" maxWidth="1.7976931348623157E308">
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </Label>

        <!-- Back Button -->
        <Button fx:id="backToMainDashBoardButton" mnemonicParsing="false" onAction="#backToMainDashBoard"
                text="Back To Main Dashboard" maxWidth="1.7976931348623157E308">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
