<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.executionDashboard.historyPanel.HistoryPanelController">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Command History Chain:" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
            </Label>
            <TableView fx:id="historyTable" prefHeight="410.0" prefWidth="512.6666666666667">
               <columns>
                  <TableColumn fx:id="idColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="50.0" sortable="false" text="#" />
                  <TableColumn fx:id="typeColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="50.0" sortable="false" text="B\S" />
                  <TableColumn fx:id="cyclesColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="50.0" sortable="false" text="Cycles" />
                  <TableColumn fx:id="labelColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="50.0" sortable="false" text="Label" />
                  <TableColumn fx:id="instructionColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="300.0" sortable="false" text="Instruction" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
