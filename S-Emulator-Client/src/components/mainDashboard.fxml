<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.clientMainController">

    <!-- 1 column -->
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="40.0" />
      <ColumnConstraints percentWidth="60.0" />
    </columnConstraints>

    <!-- row 0 = header (fixed height), row 1 = users (grows) -->
    <rowConstraints>
        <RowConstraints minHeight="40.0" prefHeight="60.0" vgrow="NEVER" />   <!-- header -->
        <RowConstraints vgrow="ALWAYS" />                                   <!-- users -->
    </rowConstraints>

    <children>
        <fx:include fx:id="headerPanel" source="mainDashboard/header/header.fxml" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" />
        <fx:include fx:id="usersPanel" source="mainDashboard/users/users.fxml" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
        <fx:include fx:id="programsAndFunctionsPanel" source="mainDashboard/ProgramsAndFunctions/ProgramsAndFunctions.fxml" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="NEVER" />
    </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</GridPane>
